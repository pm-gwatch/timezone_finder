# Extra paths excluded from the published package.
#
# With a root `.pubignore`, pub does not apply the root `.gitignore` — repeat
# anything that must not ship (see dart.dev/tools/pub/publishing).

# Local working notes (also gitignored as /docs/).
docs/

# Not for consumers.
test/
tool/

# Library packages omit the lockfile.
# https://dart.dev/tools/pub/private-files
pubspec.lock
